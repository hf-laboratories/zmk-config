/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T      &kp Y &kp U &kp I &kp O &kp P
                &kp A &kp S &kp D &kp F &kp G      &kp H &kp J &kp K &kp L &kp SCLN
                &kp Z &kp X &kp C &kp V &kp B      &kp N &kp M &kp COMMA &kp DOT &kp SLASH
                            &mo 1 &kp SPACE        &kp ENTER &mo 2
            >;
        };

        lower_layer {
            bindings = <
                &kp ESC &kp 1 &kp 2 &kp 3 &kp 4     &kp 5 &kp 6 &kp 7 &kp 8 &kp 9
                &trans &kp MINUS &kp EQUAL &kp LBKT &kp RBKT  &kp GRAVE &kp BACKSLASH &kp QUOTE &trans &trans
                &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
                            &trans &trans            &trans &trans
            >;
        };

        raise_layer {
            bindings = <
                &kp TAB &kp F1 &kp F2 &kp F3 &kp F4   &kp F5 &kp F6 &kp F7 &kp F8 &kp F9
                &kp LGUI &kp LALT &kp LCTRL &kp LSHIFT &trans  &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
                            &trans &trans            &trans &trans
            >;
        };
    };
};